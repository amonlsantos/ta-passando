{
  "name": "epg-api",
  "version": "1.0.0",
  "description": "EPG API Backend - Intermediary API for TV channel schedules",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "mock": "node test/mock-epg.mjs"
  },
  "keywords": [
    "epg",
    "tv",
    "schedule",
    "fastify"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "dotenv": "^16.4.5",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^4.28.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
