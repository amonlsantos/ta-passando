# O core.autocrlf=true do ~/.gitconfig global faria o Git gravar CRLF no
# checkout, o que quebra o android/gradlew e polui diffs. Este arquivo tem
# precedência sobre a config global: LF no repositório e no disco.
* text=auto eol=lf

*.sh text eol=lf
gradlew text eol=lf
*.bat text eol=crlf
*.mjs text eol=lf
*.ts text eol=lf

# binários que não devem ser normalizados
*.png binary
*.jpg binary
*.ico binary
*.ttf binary
*.woff binary
*.woff2 binary
*.jar binary
*.keystore binary
